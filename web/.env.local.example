# Fanout web config. Copy to web/.env.local. All values are inlined into the
# client bundle at build time (NEXT_PUBLIC_*), so never put secrets here.

# Backend base URL. Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase magic-link auth. Leave BOTH empty for dev mode (no login screen).
# Setting them turns on the login gate, so the backend must then have
# SUPABASE_JWT_SECRET set to the same project's secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
