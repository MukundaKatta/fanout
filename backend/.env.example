# Fanout backend config. Copy to backend/.env (loaded by app/main.py regardless
# of cwd; real environment variables take precedence over this file).

# --- LLM (required for /generate, /variations, /operator/run, /research/suggest)
# Free key: https://console.groq.com/keys. The server starts without it; only
# the LLM-backed endpoints fail.
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Database
# Default matches docker-compose.yml (`docker compose up -d db` or scripts/dev.sh).
# For Supabase use the Postgres URI from Settings > Database > Connection string,
# keeping the `postgresql+psycopg://` driver prefix. SQLite works for quick
# hacking: sqlite:///./fanout.db
# Tables are auto-created on startup (SQLAlchemy create_all); migrations/ is
# for Supabase / existing databases.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fanout

# --- Auth (Supabase)
# JWT secret from Supabase Settings > API > JWT Settings > JWT Secret.
# Leave EMPTY for single-user dev mode: every request is treated as user
# 00000000-0000-0000-0000-000000000000 and no bearer token is required.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- CORS: comma-separated origins allowed to call the API ("*" if unset).
CORS_ORIGINS=http://localhost:3000

# --- Service-auth cron ticks (optional)
# POST /research/tick/all and /operator/tick/all return 403 unless these are
# set; callers send the value in the X-Tick-Secret header.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
RESEARCH_TICK_SECRET=
OPERATOR_TICK_SECRET=
