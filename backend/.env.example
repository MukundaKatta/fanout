# LLM
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database — Supabase Postgres connection string (Settings > Database > Connection string > URI)
# For local dev, you can also use a local Postgres or sqlite by changing this.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/fanout

# Supabase auth — JWT secret from Settings > API > JWT Settings > JWT Secret
# If empty, the API refuses authenticated requests (503) unless FANOUT_DEV_NO_AUTH=1.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Single-user local dev mode: ONLY honoured when SUPABASE_JWT_SECRET is empty.
# Every request is treated as one fixed user with no authentication.
# NEVER set this on a deployed backend.
FANOUT_DEV_NO_AUTH=1

# CORS
CORS_ORIGINS=http://localhost:3000
